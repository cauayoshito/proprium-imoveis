# ---------------------------------------------------------------------------
# Proprium — variáveis de ambiente (exemplo)
# Copie para .env e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL (Neon). Bloco 1.
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Autenticação própria (JWT + bcrypt). Bloco 2.
# Gere um segredo forte, ex.: openssl rand -base64 32
JWT_SECRET=

# Serviço de resumo de risco (services/risk-analyzer, FastAPI). Bloco 5.
# Em desenvolvimento: uvicorn app.main:app --port 8000
RISK_ANALYZER_URL=http://localhost:8000

# WhatsApp — alertas de novos imóveis no perfil de busca. Bloco 6.
# (provedor a definir: Meta Cloud API / Twilio)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Pagamentos / assinatura. Bloco 7.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL pública do app (callbacks, links em alertas)
NEXT_PUBLIC_APP_URL=http://localhost:3000
